{
  "name": "sleepbot",
  "version": "0.1.0",
  "description": "MCP server + GUI connecting Claude to fantasy football leagues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sleepbot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "api": "node --env-file-if-exists=.env --import tsx src/api/index.ts",
    "api:start": "node --env-file-if-exists=.env dist/api/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
