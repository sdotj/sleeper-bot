# SleepBot — a fantasy-football MCP server.
# Architecture map maintained with Cairn. Grammar reference:
# https://github.com/cairn-framework/cairn/blob/HEAD/docs/blueprint.md
#
# Modules whose code does not exist yet appear as `ghost` nodes (see
# `cairn frontier`). That is intentional: we declare the architecture first,
# then `cairn scan` confirms each node as the code lands.

System SleepBot "MCP server connecting Claude to fantasy football leagues" id "sleepbot" {
    todos "./meta/todos"
    decisions "./meta/decisions"

    Module Server "MCP server entrypoint: registers tools, loads config, serves over stdio" id "sleepbot.server" {
        path "./src/index.ts"
    }

    Module Config "Config loading and zod schema for the leagues[] array" id "sleepbot.config" {
        path "./src/config"
    }

    Container Adapters "Platform-agnostic league core: one interface, one implementation per platform" id "sleepbot.adapters" {

        Module Interface "LeagueAdapter interface that every platform implements" id "sleepbot.adapters.interface" {
            path "./src/adapters/LeagueAdapter.ts"
        }

        Module Sleeper "Sleeper adapter + thin client over the public api.sleeper.app" id "sleepbot.adapters.sleeper" {
            path "./src/adapters/sleeper"
        }
    }

    Module Tools "MCP tool definitions (read-only in Phase 1) and their registration" id "sleepbot.tools" {
        path "./src/tools"
    }

    Module Rules "Rules engine: block / warn / auto-execute rules evaluated against every proposed write" id "sleepbot.rules" @phase2 {
        path "./src/rules"
    }

    Module Actions "Proposed-action model, pending-action store, and the confirm-then-execute pipeline" id "sleepbot.actions" @phase2 {
        path "./src/actions"
    }

    Module Value "Pluggable player-value provider used by trade-fairness warn rules (generic to start)" id "sleepbot.value" @phase2 {
        path "./src/value"
    }

    Module Audit "Persistent, append-only log of proposed / executed / rejected actions" id "sleepbot.audit" @phase2 {
        path "./src/audit"
    }

    Module Auth "Sleeper session-credential handling: load, detect expiry, refresh where safe, flag re-auth" id "sleepbot.auth" @phase2 {
        path "./src/auth"
    }

    Module Core "Shared app wiring + operations facade every front-end (MCP, HTTP, chat) calls" id "sleepbot.core" @phase3 {
        path "./src/core"
    }

    Module Api "Local HTTP API (Fastify) exposing the core operations to the GUI" id "sleepbot.api" @phase3 {
        path "./src/api"
    }

    Module Gate "Login gate: single predetermined-user JWT auth guarding the HTTP API (scrypt password, @fastify/jwt)" id "sleepbot.gate" @cloud {
        path "./src/gate"
    }

    Module Crypto "AES-256-GCM sealing for UI-editable secrets stored in the DB (key from SLEEPBOT_SECRET_KEY)" id "sleepbot.crypto" @cloud {
        path "./src/crypto"
    }

    Module Chat "Server-side Claude chat loop: Anthropic Messages API tool-use over SleepBot operations" id "sleepbot.chat" @phase3 {
        path "./src/chat"
    }

    Module History "Chat persistence in the store: conversations (list/resume/rename/delete) + long-term memory injected into every chat" id "sleepbot.history" @cloud {
        path "./src/history"
    }

    Module Gui "React (Vite) front-end: roster, standings/matchups, audit log, chat panel" id "sleepbot.gui" @phase3 {
        path "./web"
    }

    Module Draft "Draft board reads + best-available / roster-need recommendations (read-only; you make picks in Sleeper)" id "sleepbot.draft" @drafts {
        path "./src/draft"
    }

    Module Agent "Autonomous manager: scheduled sweep that reasons with Claude and proposes waiver/add-drop/trade actions through the pipeline" id "sleepbot.agent" @autonomous {
        path "./src/agent"
    }

    Module Notify "Telegram bot: proposal alerts with approve / deny / override, executing on your reply" id "sleepbot.notify" @autonomous {
        path "./src/notify"
    }

    Actor SleeperApi "Sleeper's HTTP API — public read endpoints, plus the unofficial private write endpoints (session-auth)" id "sleepbot.sleeper-api" @external {
    }

    Actor AnthropicApi "Anthropic Messages API (Claude), driven server-side by the chat loop" id "sleepbot.anthropic-api" @external {
    }

    Actor TelegramApi "Telegram Bot API — sends alerts and delivers your approve/deny/override taps" id "sleepbot.telegram-api" @external {
    }
}

# Dependencies
sleepbot.server           -> sleepbot.tools               "registers all tools with the MCP server"
sleepbot.server           -> sleepbot.config              "loads leagues config at startup"
sleepbot.tools            -> sleepbot.core                "binds shared core operations as MCP tools"
sleepbot.tools            -> sleepbot.config              "resolves a leagueId label to its config entry"
sleepbot.adapters.sleeper -> sleepbot.adapters.interface  "implements LeagueAdapter"
sleepbot.adapters.sleeper -> sleepbot.sleeper-api         "fetches league data over HTTP"

# Phase 2 — write actions, rules, value, audit, auth
sleepbot.tools            -> sleepbot.actions             "proposes write actions and executes confirmed ones"
sleepbot.actions          -> sleepbot.rules              "evaluates every proposed action before it is shown"
sleepbot.actions          -> sleepbot.adapters.interface  "executes a confirmed write via the adapter"
sleepbot.actions          -> sleepbot.audit              "records every proposed / executed / rejected action"
sleepbot.rules            -> sleepbot.value              "warn rules consult player value"
sleepbot.rules            -> sleepbot.adapters.interface  "reads league state to evaluate rules (e.g. positional rank)"
sleepbot.adapters.sleeper -> sleepbot.auth               "obtains a session credential for write calls"
sleepbot.auth             -> sleepbot.sleeper-api         "authenticates to obtain / refresh a session token"

# Phase 3 — local GUI: shared core, HTTP API, chat loop, React front-end
sleepbot.core             -> sleepbot.config             "loads league config"
sleepbot.core             -> sleepbot.adapters.interface  "builds adapters; exposes read operations"
sleepbot.core             -> sleepbot.actions            "exposes propose / execute / pending operations"
sleepbot.core             -> sleepbot.audit              "exposes audit-log reads"
sleepbot.core             -> sleepbot.auth               "constructs the write session"
sleepbot.core             -> sleepbot.value              "constructs the value provider"
sleepbot.api              -> sleepbot.core               "serves core operations over local HTTP"
sleepbot.api              -> sleepbot.chat               "hosts the /api/chat endpoint"
sleepbot.chat             -> sleepbot.core               "exposes core operations as Claude tools"
sleepbot.chat             -> sleepbot.anthropic-api      "runs the Messages API tool-use loop"
sleepbot.gui              -> sleepbot.api                "calls the local HTTP API"

# Access gate — login/JWT protecting the HTTP surface before a public deploy
sleepbot.api              -> sleepbot.gate               "verifies a login JWT on protected routes; issues one at /api/login"

# UI-editable config + secrets — config lives in the store, secrets sealed at rest
sleepbot.core             -> sleepbot.crypto             "seals UI-set secrets (the Sleeper token) before storing them"

# Chat history — persistent conversations (a store sink; no back-edge, no cycle)
sleepbot.core             -> sleepbot.history            "composes the conversation store onto the context"
sleepbot.chat             -> sleepbot.history            "loads/saves the active conversation around a persisted turn"

# Drafts — read-only board + recommendations assistant
sleepbot.draft            -> sleepbot.adapters.interface  "reads drafts, picks, and the player pool"
sleepbot.draft            -> sleepbot.value              "ranks available players by value"
sleepbot.core             -> sleepbot.draft              "exposes draft board + recommendation operations"

# Autonomous manager + Telegram approvals
sleepbot.agent            -> sleepbot.core               "reads league state and proposes actions via the pipeline"
sleepbot.agent            -> sleepbot.anthropic-api      "reasons over the league with Claude + web search"
sleepbot.agent            -> sleepbot.notify             "sends proposals for approval / notification"
sleepbot.notify           -> sleepbot.core               "executes or discards a pending action on your reply"
sleepbot.notify           -> sleepbot.telegram-api       "sends alerts and receives approve / deny / override callbacks"
sleepbot.api              -> sleepbot.agent              "starts the scheduled sweep + Telegram poller when enabled"
