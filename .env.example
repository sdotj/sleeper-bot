# SleepBot environment variables.
# Copy to `.env` and fill in as needed. Phase 1 reads (Sleeper public API)
# need NONE of these. Writes (Phase 2) need a Sleeper session token.

# --- Sleeper write actions (unofficial private GraphQL API) ---
# How to capture your token (no password ever leaves your browser):
#   1. Log in at https://sleeper.com in a desktop browser.
#   2. Open DevTools → Network tab. Filter for "graphql".
#   3. Click any graphql request → Headers → Request Headers.
#   4. Copy the FULL value of the `authorization` header (a long JWT, "eyJ...").
#   5. Paste it below as SLEEPER_TOKEN. It is a JWT and expires; re-capture when
#      SleepBot reports needs-reauth (check with the get_auth_status tool).
# NOTE: reaching sleeper.com/graphql may require a VPN on some networks/regions.
# SLEEPER_TOKEN=

# --- Phase 3: in-app chat panel (server-side Claude) ---
# Enables the GUI chat panel. The key stays on the server; the browser never
# sees it. Without it, the chat endpoint returns a clear "set ANTHROPIC_API_KEY"
# message and the rest of the app works normally.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5        # optional; defaults to claude-opus-5
# ANTHROPIC_DRAFT_MODEL=               # optional; a faster model for the draft-room chat
#                                        (defaults to ANTHROPIC_MODEL). Keep it snappy during a live draft.
# SLEEPBOT_WEB_SEARCH=on               # on|off. Lets the chat pull current news/injuries on demand.
#                                        Draft chat only searches when you explicitly ask (capped 1/turn).

# --- Player value (KeepTradeCut) ---
# Which KTC values to use for trade warnings + draft recommendations:
#   sf  = superflex (default)   oqb = 1-QB leagues (QBs valued lower)
# Set oqb if your league starts only one QB (no SUPER_FLEX slot).
# SLEEPBOT_KTC_MODE=oqb
# SLEEPBOT_KTC=config/ktc-values.json   # optional: path to a fresher dynasty snapshot
# SLEEPBOT_DST=config/dst-ranks.json    # optional: your own season-long defense tier
#   (copy config/dst-ranks.example.json and reorder). This is the SKILL half of
#   defense value; weekly MATCHUP streaming is handled by the chat via web search.

# --- Autonomous manager + Telegram approvals ---
# Opt a league in via its config `agent` block (see config/leagues.example.json).
# The agent needs ANTHROPIC_API_KEY (above) to reason, and Telegram to ask you.
# Create a bot with @BotFather to get the token; get your chat id from @userinfobot.
# Without these, the agent stays off and the rest of the app is unaffected.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Delivery mode:
#  - Long-poll + in-process scheduler (a VM / always-on host): leave the two
#    below unset. Sweeps every SLEEPBOT_AGENT_INTERVAL_MIN minutes (default 360).
# SLEEPBOT_AGENT_INTERVAL_MIN=360
#  - Webhook + external cron (scale-to-zero / Cloud Run, $0): set a public URL
#    and a shared secret. Telegram taps POST to <URL>/internal/telegram (woken
#    from zero), and Cloud Scheduler POSTs <URL>/internal/sweep on a cron with
#    header `Authorization: Bearer <secret>` (or `X-Sleepbot-Secret: <secret>`).
# SLEEPBOT_PUBLIC_URL=https://your-service.run.app
# SLEEPBOT_INTERNAL_SECRET=long-random-string

# --- Login gate (protect the HTTP API + GUI before a public deploy) ---
# A single predetermined login guards every /api route (and the GUI). Enabled
# ONLY when all three are set; unset ⇒ the API is open (fine for localhost).
# REQUIRED before any --allow-unauthenticated / public deploy.
#   1. Pick a username.
#   2. Hash your password (the raw password is never stored):
#        npm run hash-password -- 'your-password'      # prints a scrypt$... string
#      or run `npm run hash-password` and type it at the prompt (keeps it out of
#      shell history). Paste the output as SLEEPBOT_AUTH_PASSWORD_HASH.
#   3. Set a long random SLEEPBOT_JWT_SECRET (rotating it logs everyone out).
# SLEEPBOT_AUTH_USER=sam
# SLEEPBOT_AUTH_PASSWORD_HASH=scrypt$16384$8$1$...$...
# SLEEPBOT_JWT_SECRET=long-random-string
# SLEEPBOT_AUTH_TTL=7d                  # optional; login lifetime (jsonwebtoken format)

# --- Secret storage key (edit the Sleeper token from the Settings panel) ---
# When set (32 bytes), the Settings panel can store your Sleeper write token,
# encrypted at rest in the DB (AES-256-GCM). Unset ⇒ the token field is
# read-only and the app uses SLEEPER_TOKEN from the env. Generate one with:
#   npm run gen-secret-key
# It's a bootstrap secret (never editable from the UI); rotating it makes
# previously stored secrets undecryptable (the app falls back to the env token).
# SLEEPBOT_SECRET_KEY=

# --- Phase 4: ESPN adapter (cookie-based private API) ---
# ESPN_SWID=
# ESPN_S2=
